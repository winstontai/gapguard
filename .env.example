# Run mode: devnet | mainnet-dry-run | mainnet-live
# devnet           - generic Solana plumbing tests only, xStocks/Jupiter are mainnet-only
# mainnet-dry-run  - real reads (prices, gap calc), no signing/sending ever, Telegram-only "would hedge" reports
# mainnet-live     - real signing/sending, gated by RiskLimits
RUN_MODE=mainnet-dry-run

# RPC endpoint. Use a paid provider (Helius, Triton, etc) for reliable rate limits once this is
# polling continuously - public mainnet-beta will not hold up.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com

# Wallet: EITHER a base58-encoded secret key, OR a path to a keypair JSON file.
# Only required for RUN_MODE=mainnet-live - dry-run never signs, so leave these blank to just look
# around. Use a dedicated hot/burner wallet, kept outside this repo and outside any synced folder,
# funded only with hedge operating capital. Never your main wallet.
WALLET_PRIVATE_KEY=
WALLET_KEYPAIR_PATH=

# Telegram bot control surface (talk to @BotFather to create a bot and get a token).
# Optional: leave both blank to run the local dashboard and monitor with no Telegram account.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Local dashboard (http://127.0.0.1:<port>, loopback only)
WEB_PORT=8788

# SQLite database path
DATABASE_PATH=./data/gapguard.sqlite

# Jupiter API base URLs. lite-api.jup.ag is the free tier (no key, lower rate limits) - switch to
# api.jup.ag + JUPITER_API_KEY for production-grade rate limits.
JUPITER_PRICE_BASE_URL=https://lite-api.jup.ag/price/v3
JUPITER_SWAP_BASE_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=

# Real shorts: Kamino's xStocks lending market (supply USDC, borrow the xStock, sell it).
# HEDGE_TARGET_LTV is the loan-to-value a short opens at, capped at 0.6 in code. Kamino applies a
# borrow factor to xStock debt (1.66 for QQQx in Sept 2026), so a $100 short at 0.4 needs ~$415 USDC.
KAMINO_XSTOCKS_MARKET=5wJeMrUYECGq41fxRESKALVcHnNX26TAWy4W98yULsua
HEDGE_TARGET_LTV=0.4

# Risk limits, in USD notional (enforced in code, these only set the values - see
# src/hedge/riskLimits.ts). USD, not SOL, because a hedge is sized off your real
# dollar stock exposure.
MAX_USD_PER_HEDGE=100
MAX_DAILY_USD=500
MIN_SECONDS_BETWEEN_HEDGES=30

# Gap alerting
GAP_ALERT_THRESHOLD_PCT=2.0
GAP_POLL_INTERVAL_SECONDS=60

# Log level
LOG_LEVEL=info
