{
  "name": "gapguard",
  "version": "0.1.0",
  "description": "Weekend/overnight gap-risk guard for real stock portfolios, using xStocks' 24/7 Solana market as a hedge instrument while your broker is closed",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run test",
    "fork:e2e": "tsx scripts/fork-e2e.ts",
    "backtest": "tsx scripts/backtest.ts"
  },
  "dependencies": {
    "@kamino-finance/klend-sdk": "^12.0.0",
    "@solana/kit": "^2.3.0",
    "@solana/web3.js": "^1.99.0",
    "better-sqlite3": "^13.0.3",
    "bs58": "^6.0.0",
    "dotenv": "^17.4.2",
    "grammy": "^1.46.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
